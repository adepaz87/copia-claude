  "text": "<meta name=\"dash-one-writer\">\n<style>\n  .cm { font-family: var(--font-anthropic-sans); display: flex; flex-direction: column; gap: var(--cds-gap-lg); }\n  .cm-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--cds-gap-md); }\n  .cm-head > div { min-width: 0; }\n  .cm-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .cm-take { color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 0; max-width: 62ch; }\n  .cm-take b, .cm-kpi b, .cm .cm-num { font-weight: 500; }\n  .cm-ctrl { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); align-items: center; }\n  .cm-ctrl label { display: flex; flex-direction: column; gap: 2px; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .cm-ctrl input, .cm-ctrl select, .cm-ctrl button { font: inherit; font-size: var(--cds-font-size-body); color: var(--color-fg); background: var(--color-panel);\n    border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: 6px 10px; }\n  .cm-ctrl button { cursor: pointer; align-self: flex-end; }\n  .cm-pdf { align-self: flex-end; padding: 6px 0; color: var(--color-fg); font-weight: 500; }\n  .cm-ctrl button:focus-visible, .cm-ctrl input:focus-visible, .cm-ctrl select:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 1px; }\n  .cm-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr)); gap: var(--cds-gap-md); }\n  .cm-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .cm-kpi h3, .cm-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .cm-kpi h3 { font-size: var(--cds-font-size-body); color: var(--color-fg-muted); }\n  .cm-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: var(--cds-gap-xs) 0 var(--cds-gap-sm); font-variant-numeric: tabular-nums; }\n  .cm-deltas { display: grid; grid-template-columns: auto 1fr; gap: 2px var(--cds-gap-sm); font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .cm-deltas dt { color: var(--color-fg-muted); }\n  .cm-deltas dd { margin: 0; text-align: right; }\n  .cm-note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: var(--cds-gap-xs) 0 var(--cds-gap-md); }\n  .up { color: var(--color-ok); } .down { color: var(--color-bad); }\n  .cm-scroll { overflow-x: auto; }\n  .cm table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; font-size: var(--cds-font-size-body); }\n  .cm th { text-align: right; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); font-size: var(--cds-font-size-caption);\n    padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; position: sticky; top: 0; background: var(--color-panel); }\n  .cm td { text-align: right; padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .cm th:first-child, .cm td:first-child { text-align: left; }\n  .cm-grp th { text-align: center; color: var(--color-fg); }\n  .cm-chart { position: relative; min-height: 260px; }\n  .cm-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius);\n    box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; }\n  .cm-tip .d { color: var(--cds-text-secondary); }\n  .cm-tip i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 5px; }\n  [data-dash-source-state=empty] { color: transparent; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"cm\" lang=\"es\">\n  <div class=\"cm-head\">\n    <div>\n      <h1 class=\"cm-title\" id=\"titulo\">Ventas de El Café de Don Manuel</h1>\n      <p class=\"cm-take\">El <b data-draw=\"fecha-larga\">—</b> se vendieron <b data-draw=\"v\" data-k=\"ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"ventas\">—</b> en <b data-draw=\"v\" data-k=\"pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"pedidos\">—</b> pedidos, <b data-draw=\"v\" data-k=\"var_ventas_s\" data-f=\"pctw\" data-source=\"resumen\" data-field=\"var_ventas_s\">—</b> que el mismo día de la semana anterior.</p>\n    </div>\n    <div class=\"cm-ctrl\">\n      <label for=\"cm-fecha\">Día<input id=\"cm-fecha\" class=\"cm-fecha\" type=\"date\" min=\"2025-01-01\" max=\"2099-12-31\"></label>\n      <label for=\"cm-local\">Local<select id=\"cm-local\" class=\"cm-local\">\n        <option value=\"Todos\">Los dos locales</option>\n        <option value=\"El Paso\">El Paso</option>\n        <option value=\"Los Llanos\">Los Llanos</option>\n      </select></label>\n      <button type=\"button\" class=\"cm-reset\">Último día</button>\n      <a class=\"cm-pdf\" href=\"https://claude.ai/artifact/2it6hmgWXewAa5LsciSbKt\" target=\"_blank\" rel=\"noopener\">Descargar informes en PDF</a>\n    </div>\n  </div>\n\n  <section class=\"cm-kpis\" id=\"dia\" aria-label=\"Cifras del día\">\n    <div class=\"cm-card cm-kpi\">\n      <h3>Ventas (IGIC incluido)</h3>\n      <div class=\"cm-big\" data-draw=\"v\" data-k=\"ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"ventas\" data-fetchpriority=\"high\">—</div>\n      <dl class=\"cm-deltas\">\n        <dt>Día anterior</dt><dd data-draw=\"v\" data-k=\"var_ventas_d\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ventas_d\">—</dd>\n        <dt>Semana anterior</dt><dd data-draw=\"v\" data-k=\"var_ventas_s\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ventas_s\">—</dd>\n        <dt>Año anterior</dt><dd data-draw=\"v\" data-k=\"var_ventas_a\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ventas_a\">—</dd>\n      </dl>\n    </div>\n    <div class=\"cm-card cm-kpi\">\n      <h3>Pedidos</h3>\n      <div class=\"cm-big\" data-draw=\"v\" data-k=\"pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"pedidos\">—</div>\n      <dl class=\"cm-deltas\">\n        <dt>Día anterior</dt><dd data-draw=\"v\" data-k=\"var_pedidos_d\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_pedidos_d\">—</dd>\n        <dt>Semana anterior</dt><dd data-draw=\"v\" data-k=\"var_pedidos_s\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_pedidos_s\">—</dd>\n        <dt>Año anterior</dt><dd data-draw=\"v\" data-k=\"var_pedidos_a\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_pedidos_a\">—</dd>\n      </dl>\n    </div>\n    <div class=\"cm-card cm-kpi\">\n      <h3>Ticket medio</h3>\n      <div class=\"cm-big\" data-draw=\"v\" data-k=\"ticket\" data-f=\"eur\" data-source=\"resumen\" data-field=\"ticket\">—</div>\n      <dl class=\"cm-deltas\">\n        <dt>Día anterior</dt><dd data-draw=\"v\" data-k=\"var_ticket_d\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ticket_d\">—</dd>\n        <dt>Semana anterior</dt><dd data-draw=\"v\" data-k=\"var_ticket_s\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ticket_s\">—</dd>\n        <dt>Año anterior</dt><dd data-draw=\"v\" data-k=\"var_ticket_a\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ticket_a\">—</dd>\n      </dl>\n    </div>\n    <div class=\"cm-card cm-kpi\">\n      <h3>IGIC</h3>\n      <div class=\"cm-big\" data-draw=\"v\" data-k=\"igic\" data-f=\"eur\" data-source=\"resumen\" data-field=\"igic\">—</div>\n      <dl class=\"cm-deltas\">\n        <dt>Día anterior</dt><dd data-draw=\"v\" data-k=\"var_igic_d\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_igic_d\">—</dd>\n        <dt>Semana anterior</dt><dd data-draw=\"v\" data-k=\"var_igic_s\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_igic_s\">—</dd>\n        <dt>Año anterior</dt><dd data-draw=\"v\" data-k=\"var_igic_a\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_igic_a\">—</dd>\n      </dl>\n    </div>\n    <div class=\"cm-card cm-kpi\">\n      <h3>Neto sin IGIC</h3>\n      <div class=\"cm-big\" data-draw=\"v\" data-k=\"neto\" data-f=\"eur\" data-source=\"resumen\" data-field=\"neto\">—</div>\n      <dl class=\"cm-deltas\">\n        <dt>Día anterior</dt><dd data-draw=\"v\" data-k=\"var_neto_d\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_neto_d\">—</dd>\n        <dt>Semana anterior</dt><dd data-draw=\"v\" data-k=\"var_neto_s\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_neto_s\">—</dd>\n        <dt>Año anterior</dt><dd data-draw=\"v\" data-k=\"var_neto_a\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_neto_a\">—</dd>\n      </dl>\n    </div>\n  </section>\n\n  <section class=\"cm-card\" id=\"acumulados\">\n    <h2>Acumulados hasta el día elegido</h2>\n    <p class=\"cm-note\">Mes en curso frente al mes anterior y al mismo mes del año pasado, contando los mismos días; año en curso frente al mismo periodo del año pasado. Año anterior en los días sueltos es la misma fecha del año pasado.</p>\n    <div class=\"cm-scroll\">\n      <table>\n        <thead>\n          <tr class=\"cm-grp\"><th></th><th colspan=\"3\">Mes frente al mes anterior</th><th colspan=\"2\">Mes frente al año pasado</th><th colspan=\"3\">Año frente al año pasado</th></tr>\n          <tr><th>Métrica</th><th>Este mes</th><th>Mes anterior</th><th>Var.</th><th>Año pasado</th><th>Var.</th><th>Este año</th><th>Año pasado</th><th>Var.</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>Ventas (€)</td>\n            <td data-draw=\"v\" data-k=\"mes_ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mes_ventas\">—</td>\n            <td data-draw=\"v\" data-k=\"mesp_ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesp_ventas\">—</td>\n            <td data-draw=\"v\" data-k=\"var_ventas_mesp\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ventas_mesp\">—</td>\n            <td data-draw=\"v\" data-k=\"mesa_ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesa_ventas\">—</td>\n            <td data-draw=\"v\" data-k=\"var_ventas_mesa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ventas_mesa\">—</td>\n            <td data-draw=\"v\" data-k=\"anio_ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anio_ventas\">—</td>\n            <td data-draw=\"v\" data-k=\"anioa_ventas\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anioa_ventas\">—</td>\n            <td data-draw=\"v\" data-k=\"var_ventas_anioa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ventas_anioa\">—</td></tr>\n          <tr><td>Pedidos</td>\n            <td data-draw=\"v\" data-k=\"mes_pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"mes_pedidos\">—</td>\n            <td data-draw=\"v\" data-k=\"mesp_pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"mesp_pedidos\">—</td>\n            <td data-draw=\"v\" data-k=\"var_pedidos_mesp\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_pedidos_mesp\">—</td>\n            <td data-draw=\"v\" data-k=\"mesa_pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"mesa_pedidos\">—</td>\n            <td data-draw=\"v\" data-k=\"var_pedidos_mesa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_pedidos_mesa\">—</td>\n            <td data-draw=\"v\" data-k=\"anio_pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"anio_pedidos\">—</td>\n            <td data-draw=\"v\" data-k=\"anioa_pedidos\" data-f=\"int\" data-source=\"resumen\" data-field=\"anioa_pedidos\">—</td>\n            <td data-draw=\"v\" data-k=\"var_pedidos_anioa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_pedidos_anioa\">—</td></tr>\n          <tr><td>Ticket medio (€)</td>\n            <td data-draw=\"v\" data-k=\"mes_ticket\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mes_ticket\">—</td>\n            <td data-draw=\"v\" data-k=\"mesp_ticket\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesp_ticket\">—</td>\n            <td data-draw=\"v\" data-k=\"var_ticket_mesp\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ticket_mesp\">—</td>\n            <td data-draw=\"v\" data-k=\"mesa_ticket\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesa_ticket\">—</td>\n            <td data-draw=\"v\" data-k=\"var_ticket_mesa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ticket_mesa\">—</td>\n            <td data-draw=\"v\" data-k=\"anio_ticket\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anio_ticket\">—</td>\n            <td data-draw=\"v\" data-k=\"anioa_ticket\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anioa_ticket\">—</td>\n            <td data-draw=\"v\" data-k=\"var_ticket_anioa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_ticket_anioa\">—</td></tr>\n          <tr><td>IGIC (€)</td>\n            <td data-draw=\"v\" data-k=\"mes_igic\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mes_igic\">—</td>\n            <td data-draw=\"v\" data-k=\"mesp_igic\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesp_igic\">—</td>\n            <td data-draw=\"v\" data-k=\"var_igic_mesp\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_igic_mesp\">—</td>\n            <td data-draw=\"v\" data-k=\"mesa_igic\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesa_igic\">—</td>\n            <td data-draw=\"v\" data-k=\"var_igic_mesa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_igic_mesa\">—</td>\n            <td data-draw=\"v\" data-k=\"anio_igic\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anio_igic\">—</td>\n            <td data-draw=\"v\" data-k=\"anioa_igic\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anioa_igic\">—</td>\n            <td data-draw=\"v\" data-k=\"var_igic_anioa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_igic_anioa\">—</td></tr>\n          <tr><td>Neto (€)</td>\n            <td data-draw=\"v\" data-k=\"mes_neto\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mes_neto\">—</td>\n            <td data-draw=\"v\" data-k=\"mesp_neto\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesp_neto\">—</td>\n            <td data-draw=\"v\" data-k=\"var_neto_mesp\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_neto_mesp\">—</td>\n            <td data-draw=\"v\" data-k=\"mesa_neto\" data-f=\"eur\" data-source=\"resumen\" data-field=\"mesa_neto\">—</td>\n            <td data-draw=\"v\" data-k=\"var_neto_mesa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_neto_mesa\">—</td>\n            <td data-draw=\"v\" data-k=\"anio_neto\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anio_neto\">—</td>\n            <td data-draw=\"v\" data-k=\"anioa_neto\" data-f=\"eur\" data-source=\"resumen\" data-field=\"anioa_neto\">—</td>\n            <td data-draw=\"v\" data-k=\"var_neto_anioa\" data-f=\"pct\" data-source=\"resumen\" data-field=\"var_neto_anioa\">—</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"cm-card\" id=\"evolucion\">\n    <h2>Ventas por día, últimos 60 días</h2>\n    <p class=\"cm-note\">Ventas con IGIC incluido de cada local, hasta el día elegido.</p>\n    <div class=\"cm-chart\" data-draw=\"grafico\" data-source=\"ventas\"></div>\n  </section>\n\n  <section class=\"cm-card\" id=\"meses\">\n    <h2>Mes a mes frente al año pasado</h2>\n    <p class=\"cm-note\">Año del último día con datos. El mes en curso se compara con los mismos días del año pasado.</p>\n    <div class=\"cm-scroll\">\n      <table data-source=\"mensual\" data-row-key=\"mes,local\">\n        <thead><tr>\n          <th data-field=\"mes\">Mes</th>\n          <th data-field=\"ventas\">Ventas</th><th data-field=\"ventas_ant\">Año pasado</th><th data-field=\"var_ventas\">Var.</th>\n          <th data-field=\"pedidos\">Pedidos</th><th data-field=\"pedidos_ant\">Año pasado</th><th data-field=\"var_pedidos\">Var.</th>\n          <th data-field=\"ticket\">Ticket medio</th><th data-field=\"ticket_ant\">Año pasado</th><th data-field=\"var_ticket\">Var.</th>\n        </tr></thead>\n        <tbody data-draw=\"meses\"></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n\n<script>\n  dash.calc('resumen', {\n    inputs: ['ventas'],\n    title: 'Resumen por día y local',\n    description: 'Cifras de cada día por local y de los dos juntos, con sus comparaciones y acumulados.',\n    fn: (ventas) => {\n      const r2 = (x) => Math.round(x * 100) / 100;\n      const pct = (a, b) => (b ? Math.round(((a - b) / b) * 1000) / 10 : null);\n      const dia = (f, n) => { const d = new Date(f + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };\n      const por = new Map();\n      for (const r of ventas) for (const l of [r.local, 'Todos']) {\n        const k = r.fecha + '|' + l, o = por.get(k) || { ventas: 0, pedidos: 0, igic: 0 };\n        o.ventas += +r.ventas; o.pedidos += +r.pedidos; o.igic += +r.igic; por.set(k, o);\n      }\n      const met = (o) => ({ ventas: r2(o.ventas), pedidos: o.pedidos, ticket: o.pedidos ? r2(o.ventas / o.pedidos) : 0, igic: r2(o.igic), neto: r2(o.ventas - o.igic) });\n      const suma = (l, a, b) => { const t = { ventas: 0, pedidos: 0, igic: 0 };\n        for (let f = a; f <= b; f = dia(f, 1)) { const o = por.get(f + '|' + l); if (o) { t.ventas += o.ventas; t.pedidos += o.pedidos; t.igic += o.igic; } }\n        return met(t); };\n      const M = ['ventas', 'pedidos', 'ticket', 'igic', 'neto'];\n      const out = [];\n      for (const [k, o] of por) {\n        const [f, l] = k.split('|'), y = +f.slice(0, 4), cur = met(o), row = { fecha: f, local: l, ...cur };\n        for (const [c, n] of [['d', -1], ['s', -7], ['a', 0]]) {\n          const fc = c === 'a' ? String(y - 1) + f.slice(4) : dia(f, n);\n          const p = met(por.get(fc + '|' + l) || { ventas: 0, pedidos: 0, igic: 0 });\n          for (const m of M) { row[m + '_' + c] = p[m]; row['var_' + m + '_' + c] = pct(cur[m], p[m]); }\n        }\n        const ini = f.slice(0, 8) + '01', pm = dia(ini, -1), pmFin = pm.slice(0, 8) + String(Math.min(+f.slice(8), +pm.slice(8))).padStart(2, '0');\n        const prev = String(y - 1);\n        const acc = { mes: suma(l, ini, f), mesp: suma(l, pm.slice(0, 8) + '01', pmFin),\n          mesa: suma(l, prev + ini.slice(4), prev + f.slice(4)), anio: suma(l, y + '-01-01', f), anioa: suma(l, prev + '-01-01', prev + f.slice(4)) };\n        for (const m of M) {\n          for (const a in acc) row[a + '_' + m] = acc[a][m];\n          row['var_' + m + '_mesp'] = pct(acc.mes[m], acc.mesp[m]);\n          row['var_' + m + '_mesa'] = pct(acc.mes[m], acc.mesa[m]);\n          row['var_' + m + '_anioa'] = pct(acc.anio[m], acc.anioa[m]);\n        }\n        out.push(row);\n      }\n      return out;\n    },\n  });\n\n  dash.calc('mensual', {\n    inputs: ['ventas'],\n    title: 'Mes a mes frente al año pasado',\n    description: 'Ventas, pedidos y ticket medio de cada mes del último año con datos frente al mismo mes del año anterior, hasta el mismo día en el mes en curso.',\n    fn: (ventas) => {\n      const r2 = (x) => Math.round(x * 100) / 100;\n      const pct = (a, b) => (b ? Math.round(((a - b) / b) * 1000) / 10 : null);\n      const ultimo = ventas.reduce((m, r) => (r.fecha > m ? r.fecha : m), '');\n      const y = ultimo.slice(0, 4), py = String(+y - 1), mesUlt = ultimo.slice(5, 7), diaUlt = ultimo.slice(8);\n      const t = new Map();\n      for (const r of ventas) {\n        const yy = r.fecha.slice(0, 4), mm = r.fecha.slice(5, 7);\n        if ((yy !== y && yy !== py) || mm > mesUlt || (mm === mesUlt && r.fecha.slice(8) > diaUlt)) continue;\n        for (const l of [r.local, 'Todos']) {\n          const k = mm + '|' + l, o = t.get(k) || { mes: mm, local: l, v: 0, p: 0, va: 0, pa: 0 };\n          if (yy === y) { o.v += +r.ventas; o.p += +r.pedidos; } else { o.va += +r.ventas; o.pa += +r.pedidos; }\n          t.set(k, o);\n        }\n      }\n      return [...t.values()].sort((a, b) => a.mes.localeCompare(b.mes)).map((o) => {\n        const tk = o.p ? r2(o.v / o.p) : 0, tka = o.pa ? r2(o.va / o.pa) : 0;\n        return { mes: o.mes, local: o.local, ventas: r2(o.v), ventas_ant: r2(o.va), var_ventas: pct(r2(o.v), r2(o.va)),\n          pedidos: o.p, pedidos_ant: o.pa, var_pedidos: pct(o.p, o.pa), ticket: tk, ticket_ant: tka, var_ticket: pct(tk, tka) };\n      });\n    },\n  });\n\n  const fEur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', useGrouping: 'always' });\n  const fInt = new Intl.NumberFormat('es-ES', { useGrouping: 'always' });\n  const fPct = new Intl.NumberFormat('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];\n  const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];\n\n  const ultimoDia = () => {\n    const g = dash.data('ventas');\n    return g.status === 'ok' ? g.data.reduce((m, r) => (r.fecha > m ? r.fecha : m), '') : null;\n  };\n  const elegido = () => ({ fecha: dash.params().fecha || ultimoDia(), local: dash.params().local || 'Todos' });\n  const fila = () => {\n    const g = dash.data('resumen'), s = elegido();\n    return g.status === 'ok' ? g.data.find((r) => r.fecha === s.fecha && r.local === s.local) : null;\n  };\n  const pinta = (el, x, f) => {\n    el.classList.remove('up', 'down');\n    if (x == null) { el.textContent = '—'; return; }\n    if (f === 'eur') el.textContent = fEur.format(x);\n    else if (f === 'int') el.textContent = fInt.format(x);\n    else {\n      el.classList.add(x >= 0 ? 'up' : 'down');\n      el.textContent = f === 'pctw' ? `${fPct.format(Math.abs(x))} % ${x >= 0 ? 'más' : 'menos'}` : `${x >= 0 ? '▲' : '▼'} ${fPct.format(Math.abs(x))} %`;\n    }\n  };\n\n  dash.draw('v', (el) => {\n    const r = fila(), s = elegido();\n    if (!r) { el.textContent = '—'; el.classList.remove('up', 'down'); return; }\n    el.dataset.where = `fecha=${encodeURIComponent(s.fecha)}&local=${encodeURIComponent(s.local)}`;\n    pinta(el, r[el.dataset.k], el.dataset.f);\n  });\n\n  dash.draw('fecha-larga', (el) => {\n    const f = elegido().fecha;\n    if (!f) { el.textContent = '—'; return; }\n    const d = new Date(f + 'T00:00:00Z');\n    el.textContent = `${DIAS[d.getUTCDay()]} ${d.getUTCDate()} de ${MESES[d.getUTCMonth()]} de ${d.getUTCFullYear()}`;\n  });\n\n  dash.draw('meses', (tb) => {\n    const g = dash.data('mensual'), l = elegido().local;\n    tb.replaceChildren();\n    if (g.status !== 'ok') return;\n    for (const r of g.data.filter((x) => x.local === l)) {\n      const tr = document.createElement('tr');\n      tr.dataset.key = `${r.mes},${encodeURIComponent(r.local)}`;\n      const celdas = [[MESES[+r.mes - 1].replace(/^./, (c) => c.toUpperCase())],\n        [r.ventas, 'eur'], [r.ventas_ant, 'eur'], [r.var_ventas, 'pct'],\n        [r.pedidos, 'int'], [r.pedidos_ant, 'int'], [r.var_pedidos, 'pct'],\n        [r.ticket, 'eur'], [r.ticket_ant, 'eur'], [r.var_ticket, 'pct']];\n      for (const [x, f] of celdas) {\n        const td = document.createElement('td');\n        if (f) pinta(td, x, f); else td.textContent = x;\n        tr.append(td);\n      }\n      tb.append(tr);\n    }\n  });\n\n  dash.draw('grafico', (box) => {\n    box.replaceChildren();\n    const g = dash.data('ventas'), s = elegido();\n    if (g.status !== 'ok' || !s.fecha) return;\n    const fin = new Date(s.fecha + 'T00:00:00Z'), ini = d3.utcDay.offset(fin, -59);\n    const locales = s.local === 'Todos' ? ['El Paso', 'Los Llanos'] : [s.local];\n    const series = locales.map((l, i) => ({ l, c: dash.colors[i],\n      pts: g.data.filter((r) => r.local === l).map((r) => ({ d: new Date(r.fecha + 'T00:00:00Z'), v: +r.ventas }))\n        .filter((p) => p.d >= ini && p.d <= fin).sort((a, b) => a.d - b.d) }));\n    const W = box.clientWidth || 600, H = 260;\n    const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`);\n    const y = d3.scaleLinear([0, d3.max(series.flatMap((s) => s.pts), (p) => p.v) || 1], [H - 24, 8]).nice();\n    const fmtY = (v) => fInt.format(v) + ' €';\n    const tmp = svg.append('text').attr('font-size', 11).text(fmtY(y.domain()[1]));\n    const ml = tmp.node().getComputedTextLength() + 10; tmp.remove();\n    const endW = 78;\n    const x = d3.scaleUtc([ini, fin], [ml, W - endW]);\n    svg.append('g').selectAll('line').data(y.ticks(4)).join('line')\n      .attr('x1', ml).attr('x2', W - endW).attr('y1', y).attr('y2', y).attr('stroke', 'var(--cds-chart-grid)');\n    svg.append('g').selectAll('text').data(y.ticks(4)).join('text')\n      .attr('x', ml - 6).attr('y', y).attr('dy', '0.32em').attr('text-anchor', 'end')\n      .attr('fill', 'var(--color-fg-muted)').attr('font-size', 11).text(fmtY);\n    const nt = Math.max(2, Math.min(6, Math.floor((W - ml - endW) / 90)));\n    svg.append('g').selectAll('text').data(x.ticks(nt)).join('text')\n      .attr('x', x).attr('y', H - 6).attr('text-anchor', 'middle')\n      .attr('fill', 'var(--color-fg-muted)').attr('font-size', 11).text((d) => `${d.getUTCDate()} ${MESES[d.getUTCMonth()].slice(0, 3)}`);\n    const line = d3.line().x((p) => x(p.d)).y((p) => y(p.v));\n    for (const s of series) {\n      svg.append('path').attr('d', line(s.pts)).attr('fill', 'none').attr('stroke', s.c)\n        .attr('stroke-width', 2).attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round');\n    }\n    const ends = series.filter((s) => s.pts.length).map((s) => ({ s, y: y(s.pts[s.pts.length - 1].v) })).sort((a, b) => a.y - b.y);\n    for (let i = 1; i < ends.length; i++) if (ends[i].y - ends[i - 1].y < 14) ends[i].y = ends[i - 1].y + 14;\n    for (const e of ends) svg.append('text').attr('x', W - endW + 6).attr('y', e.y).attr('dy', '0.32em')\n      .attr('fill', e.s.c).attr('font-size', 11).text(e.s.l);\n    const tip = d3.select(box).append('div').attr('class', 'cm-tip').style('display', 'none');\n    const guia = svg.append('line').attr('y1', 8).attr('y2', H - 24).attr('stroke', 'var(--cds-chart-reference)').style('display', 'none');\n    const dots = svg.append('g');\n    svg.append('rect').attr('x', ml).attr('y', 0).attr('width', Math.max(0, W - endW - ml)).attr('height', H).attr('fill', 'transparent')\n      .on('pointermove', (ev) => {\n        const [mx] = d3.pointer(ev), d = d3.utcDay.round(x.invert(mx));\n        const k = +d, vals = series.map((s) => ({ s, p: s.pts.find((p) => +p.d === k) })).filter((o) => o.p);\n        if (!vals.length) return;\n        const px = x(d) * box.clientWidth / W;\n        guia.style('display', null).attr('x1', x(d)).attr('x2', x(d));\n        dots.selectAll('circle').data(vals).join('circle').attr('cx', x(d)).attr('cy', (o) => y(o.p.v)).attr('r', 3.5).attr('fill', (o) => o.s.c);\n        tip.style('display', null).html('');\n        tip.append('div').attr('class', 'd').text(`${DIAS[d.getUTCDay()]} ${d.getUTCDate()} ${MESES[d.getUTCMonth()]}`);\n        for (const o of vals) { const r = tip.append('div'); if (series.length > 1) r.append('i').style('background', o.s.c); r.append('span').text(`${o.s.l}: ${fEur.format(o.p.v)}`); }\n        const tw = tip.node().offsetWidth;\n        tip.style('left', `${Math.max(0, Math.min(box.clientWidth - tw, px + 12))}px`).style('top', '8px');\n      })\n      .on('pointerleave', () => { tip.style('display', 'none'); guia.style('display', 'none'); dots.selectAll('*').remove(); });\n  });\n\n  const inFecha = document.querySelectorAll('.cm-fecha');\n  const inLocal = document.querySelectorAll('.cm-local');\n  inFecha.forEach((el) => {\n    el.addEventListener('change', () => { if (el.value && el.validity.valid) dash.setParams({ fecha: el.value }); });\n    el.addEventListener('blur', () => { el.value = elegido().fecha || ''; });\n  });\n  inLocal.forEach((el) => el.addEventListener('change', () => dash.setParams({ local: el.value })));\n  document.querySelectorAll('.cm-reset').forEach((b) => b.addEventListener('click', () => { dash.resetParams(); }));\n  dash.onData(() => {\n    const s = elegido();\n    inFecha.forEach((el) => { if (el !== document.activeElement) { el.value = s.fecha || ''; const u = ultimoDia(); if (u) el.max = u; } });\n    inLocal.forEach((el) => { el.value = s.local; });\n  });\n</script>\n"
}
